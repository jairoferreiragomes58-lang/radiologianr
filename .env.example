# Variáveis de ambiente - Radiologia NR
# Deixe em branco para rodar em modo LOCAL (localStorage com dados de exemplo)
# Preencha com as credenciais do seu projeto Supabase para rodar na nuvem

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: chave gratuita da API OpenRouteService para cálculo automático de distância por endereço
# Se não preenchida, o Simulador usa geocodificação gratuita (Nominatim) + distância estimada ou entrada manual
VITE_ORS_API_KEY=
